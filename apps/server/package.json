{
  "name": "@shoplist/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "dev": "node --conditions=development --env-file-if-exists=../../.env --import tsx/esm --watch src/server.ts",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/shared": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "@scalar/hono-api-reference": "^0.12.1",
    "@shoplist/transport-contract": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.2",
    "hono": "^4.13.5",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
